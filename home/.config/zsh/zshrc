# Keep interactive startup offline. Network checks are explicit commands below.
[[ -o interactive ]] || return
: ${XDG_CONFIG_HOME:=$HOME/.config}
: ${XDG_CACHE_HOME:=$HOME/.cache}
: ${XDG_DATA_HOME:=$HOME/.local/share}
# Load by real path: the deployed entry point can be a symlink into the repo.
typeset _zsh_config_dir=${${(%):-%N}:A:h}
typeset _zsh_cache="$XDG_CACHE_HOME/zsh"
mkdir -p -- "$_zsh_cache"

weather() { command curl --fail --silent --show-error --max-time 2 'https://wttr.in/?0'; }
dotfiles-refresh-updates() {
    command -v checkupdates >/dev/null || return 127
    local result update_status
    result=$(command checkupdates 2>/dev/null); update_status=$?
    # checkupdates exits 2 when there are no available updates.
    (( update_status == 0 || update_status == 2 )) || return "$update_status"
    local -a updates
    updates=("${(@f)result}")
    [[ -n $result ]] || updates=()
    print -r -- ${#updates} >| "$XDG_CACHE_HOME/zsh/updates"
}
if [[ ${DOTFILES_GREETING:-0} == 1 ]]; then
    print -P '%F{magenta}Welcome back.%f'
    if [[ -r "$_zsh_cache/updates" ]]; then
        typeset _cached_updates=$(<"$_zsh_cache/updates")
        [[ $_cached_updates == <-> ]] && print -r -- "$_cached_updates package updates available (cached)"
        unset _cached_updates
    fi
fi
# Optional tool: leave it out when unavailable.
if (( $+commands[antidot] )); then
    eval "$(antidot init)"
fi

# Keep editing mode consistent even when EDITOR/VISUAL is vim.
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
# Normal/application cursor modes and common Home/End variants.
bindkey '^[[C' forward-char
bindkey '^[[D' backward-char
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search
bindkey '^[OC' forward-char
bindkey '^[OD' backward-char
bindkey '^[[H' beginning-of-line
bindkey '^[OH' beginning-of-line
bindkey '^[[1~' beginning-of-line
bindkey '^[[7~' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[OF' end-of-line
bindkey '^[[4~' end-of-line
bindkey '^[[8~' end-of-line
bindkey '^[[3~' delete-char
bindkey '^[[2~' overwrite-mode
bindkey '^[[5~' up-line-or-history
bindkey '^[[6~' down-line-or-history
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5H' beginning-of-buffer-or-history
bindkey '^[[1;5F' end-of-buffer-or-history
bindkey '^[[3;5~' kill-word
bindkey '^H' backward-delete-char
bindkey '^?' backward-delete-char
if zmodload zsh/terminfo 2>/dev/null; then
    typeset _key_cap _key_widget
    for _key_cap _key_widget in \
        khome beginning-of-line kend end-of-line \
        kdch1 delete-char kich1 overwrite-mode \
        kcuu1 up-line-or-beginning-search kcud1 down-line-or-beginning-search \
        kcub1 backward-char kcuf1 forward-char \
        kpp up-line-or-history knp down-line-or-history; do
        [[ -z ${terminfo[$_key_cap]} ]] || bindkey "${terminfo[$_key_cap]}" "$_key_widget"
    done
    unset _key_cap _key_widget
fi
autoload -Uz compinit
# Prefer prefix matches; fall back to a substring (e.g. 13 -> Folder 13).
zstyle ':completion:*' matcher-list \
    'm:{a-z}={A-Z}' \
    'm:{a-z}={A-Z} l:|=* r:|=*'
compinit -d "$_zsh_cache/zcompdump-$ZSH_VERSION"
autoload -Uz promptinit colors
promptinit
colors
HISTFILE="$_zsh_cache/history"
HISTSIZE=1000000
SAVEHIST=1000000
setopt HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS

# Source the actual plugin files; each plugin resolves its own companion files.
[[ ! -r "$_zsh_config_dir/plugins/omz-lib/git.zsh" ]] || source "$_zsh_config_dir/plugins/omz-lib/git.zsh"
if [[ -r "$_zsh_config_dir/themes/passion/passion.zsh-theme" ]]; then
    source "$_zsh_config_dir/themes/passion/passion.zsh-theme"
else
    PROMPT='%F{magenta}%n@%m%f %~ %# '
fi
# Passion's one-second alarm calls zle reset-prompt, which can re-enter the
# renderer during editing/completion. Update the clock on each new prompt.
TMOUT=0
unfunction TRAPALRM 2>/dev/null
[[ ! -r "$_zsh_config_dir/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] || source "$_zsh_config_dir/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"

alias peaclock='peaclock --config-dir "$XDG_CONFIG_HOME/peaclock"'
alias fix-bug="printf 'Bug fixed. \nNo reboot needed.\n'"
export CHROOT="$HOME/AUR/CHROOT"
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias ip='ip -color=auto'
export LESS='-R --use-color -Dd+r$Du+b$'
export MANPAGER='less -R --use-color -Dd+r -Du+b'
# gpg-agent is socket activated. No eager agent launch for every shell.
[[ ! -t 0 ]] || export GPG_TTY=$(tty)
[[ ! -r "$XDG_CONFIG_HOME/shell/interactive.local.sh" ]] || source "$XDG_CONFIG_HOME/shell/interactive.local.sh"
# Keep syntax highlighting last so it sees all registered widgets.
[[ ! -r "$_zsh_config_dir/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] || source "$_zsh_config_dir/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
unset _zsh_config_dir _zsh_cache
