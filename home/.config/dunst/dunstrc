# Mocha Pink; RGBA affects the background only (Wayland).
[global]
monitor = 0
follow = mouse
origin = top-right
offset = (10, 10)
width = (200, 600)
padding = 20
horizontal_padding = 20
text_icon_padding = 20
frame_width = 2
separator_height = 0
alignment = right
background = "#1e1e2ecc"
foreground = "#cdd6f4"
frame_color = "#f5c2e7"
highlight = "#f5c2e7"
max_icon_size = 100
icon_position = right
notification_limit = 5
indicate_hidden = true
idle_threshold = 10s
font = "Noto Sans 10"

[urgency_low]
background = "#1e1e2ecc"
foreground = "#a6adc8"
frame_color = "#45475a"
highlight = "#f5c2e7"

[urgency_normal]
background = "#1e1e2ecc"
foreground = "#cdd6f4"
frame_color = "#f5c2e7"
highlight = "#f5c2e7"

[urgency_critical]
background = "#1e1e2ecc"
foreground = "#cdd6f4"
frame_color = "#f38ba8"
highlight = "#f38ba8"
