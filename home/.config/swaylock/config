ignore-empty-password
daemonize

# fade in the blur over 2 seconds, and have a grace of 1 second
fade-in=2
grace=1

# enable the indicator and the clock
indicator
clock

# use the last open screen as the wallpaper and run effects
screenshots
effect-blur=30x4
effect-vignette=0.5:0.5

# flash black if the image hasnt loaded
color=000000

# font config
font=Iosevka Curly
font-size=50

# clock positioning (well status as well but ok)
indicator-idle-visible
indicator-thickness=0
indicator-x-position=150
indicator-y-position=1000

# yes.
text-color=cdd6f4
text-clear-color=f9e2af
text-ver-color=94e2d5
text-wrong-color=f38ba8

# Keep the original invisible ring/interior; only clock and status text show.
inside-color=00000000
inside-clear-color=00000000
inside-ver-color=00000000
inside-wrong-color=00000000

key-hl-color=00000000

layout-bg-color=00000000
layout-text-color=cdd6f430

line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000

ring-color=00000000
ring-clear-color=00000000
ring-ver-color=00000000
ring-wrong-color=00000000

# Caps-lock keeps its text state without adding visible ring/highlight geometry.
text-caps-lock-color=f9e2af
ring-caps-lock-color=00000000
inside-caps-lock-color=00000000
bs-hl-color=00000000
caps-lock-key-hl-color=00000000
caps-lock-bs-hl-color=00000000
line-caps-lock-color=00000000
separator-color=00000000
layout-border-color=00000000
