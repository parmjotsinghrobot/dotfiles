#!/bin/sh
# Keep machine-specific build products outside the source checkout.
set -eu
source_file="$HOME/.local/share/low-memory-notify/monitor.c"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/low-memory-notify"
binary="$cache_dir/monitor"
mkdir -p -- "$cache_dir"
if [ ! -x "$binary" ] || [ "$source_file" -nt "$binary" ] || [ "$0" -nt "$binary" ]; then
    build_dir=$(mktemp -d "$cache_dir/build.XXXXXX")
    trap 'rm -rf -- "$build_dir"' EXIT
    trap 'exit 1' HUP INT TERM
    cc -std=c11 -O2 -Wall -Wextra -Werror "$source_file" -o "$build_dir/monitor"
    chmod 700 "$build_dir/monitor"
    mv -f -- "$build_dir/monitor" "$binary"
    rm -rf -- "$build_dir"
    trap - EXIT HUP INT TERM
fi
exec "$binary"
